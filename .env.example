# ============================================================
# HPC Platform - environment template
# Copy to `.env` (make up does this automatically).
# Never commit the real `.env`.
# ============================================================

# ---- App ----
APP_NAME=HPC Platform API
ENV=development
DEBUG=true

# ---- Postgres ----
POSTGRES_USER=hpc
POSTGRES_PASSWORD=hpc
POSTGRES_DB=hpc
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Auth / security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# bcrypt work factor (4-31). Keep 12 in production.
BCRYPT_ROUNDS=12

# ---- Login rate limit (sliding window) ----
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# ---- CORS (JSON array) ----
CORS_ORIGINS=["http://localhost:3000","http://localhost"]

# ---- Bootstrap accounts (created by `make seed`) ----
FIRST_ADMIN_EMAIL=admin@hpc.local
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=admin12345
FIRST_USER_EMAIL=user@hpc.local
FIRST_USER_USERNAME=user
FIRST_USER_PASSWORD=user12345

# ---- Frontend (Next.js) ----
# Origin of the API. Leave empty for same-origin: the generated OpenAPI paths
# already include the /api/v1 prefix, which Caddy routes to the api service.
NEXT_PUBLIC_API_BASE_URL=

# ---- Build-time package mirrors ----
# Package registries used while building the Docker images.
# Defaults point at the official registries; override for faster builds
# behind a slow/blocked network (e.g. registry.npmmirror.com,
# pypi.tuna.tsinghua.edu.cn/simple).
NPM_REGISTRY=https://registry.npmjs.org
PIP_INDEX_URL=https://pypi.org/simple
