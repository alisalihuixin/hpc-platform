# Caddy reverse proxy for the HPC platform.
#   /api/* + docs/openapi  -> FastAPI
#   everything else        -> Next.js
{
	admin off
}

:80 {
	encode gzip zstd

	# FastAPI surface: versioned API, OpenAPI schema and Swagger/ReDoc.
	@api path /api/* /openapi.json /docs* /redoc* /health*
	handle @api {
		reverse_proxy api:8000
	}

	# Everything else is served by the Next.js app.
	handle {
		reverse_proxy web:3000
	}
}
