# Origin of the API. Leave empty for same-origin: the OpenAPI paths already
# include the /api/v1 prefix, which Caddy proxies to the api service.
NEXT_PUBLIC_API_BASE_URL=
# Only used by the `npm run dev` rewrite (apps/web/next.config.mjs).
API_PROXY_TARGET=http://localhost:8000
# `npm run dev` 的 rewrite 会缓冲流式响应（SSE 收不到任何事件），因此本地开发
# 让作业状态流直连后端。容器栈里留空：Caddy 在 Next 之前就转发 /api。
NEXT_PUBLIC_SSE_BASE_URL=http://localhost:8000
